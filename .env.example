# ── Production: скопируйте в .env в корне проекта на VPS и выполните chmod 600 .env ──
# Секрет сгенерировать:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_USER=salon
POSTGRES_DB=salon
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Домены (замените salon.ru на свой)
PUBLIC_WEB_URL=https://salon.ru
APP_URL=https://app.salon.ru
# API отдаётся с тех же доменов по пути /v1, поэтому CORS и общий домен cookie не нужны.
CORS_ORIGIN=
COOKIE_DOMAIN=

# Бэкапы (необязательно): шифровать GPG-ключом получателя
BACKUP_GPG_RECIPIENT=

# ── Этап 2 ──
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
SMS_RU_API_KEY=
SENTRY_DSN=
