# ── MioFlow, production. deploy/install.sh создаёт этот файл сам со случайными паролями. ──
# Если заполняете вручную: chmod 600 .env; секрет — openssl rand -base64 48 | tr -d '/+=' | cut -c1-40
POSTGRES_DB=mioflow
# Суперпользователь postgres (только бэкапы/обслуживание)
POSTGRES_PASSWORD=
# Владелец схемы salon_owner (миграции, системные запросы; не суперпользователь)
OWNER_DB_PASSWORD=
# Приложение salon_app (только данные своего салона — RLS)
APP_DB_PASSWORD=
JWT_SECRET=
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
VK_SECRET=
# Шифрование бэкапов AES-256. Храните копию пароля ВНЕ сервера.
BACKUP_PASSPHRASE=
# Копия бэкапов во внешнее хранилище в РФ через rclone, например yandex:mioflow-backups
BACKUP_RCLONE_REMOTE=

# Готовые образы (GitHub Container Registry)
IMAGE_PREFIX=ghcr.io/adidasdasler/mioflow
IMAGE_TAG=latest

# ── Адреса. С доменом: ──
PUBLIC_WEB_URL=https://mioflow.ru
APP_URL=https://app.mioflow.ru
NGINX_BIND=127.0.0.1
COOKIE_SECURE=true
# Без домена (по IP): PUBLIC_WEB_URL=http://IP:8080, APP_URL=http://IP:8081, NGINX_BIND=0.0.0.0, COOKIE_SECURE=false
SITE_PORT=8080
APP_PORT=8081
CORS_ORIGIN=
COOKIE_DOMAIN=
SEED_DEMO=false

# ── Интеграции ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Напоминания клиентам (все каналы бесплатны; SMS не используем)
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
VK_GROUP_TOKEN=
VK_GROUP_SCREEN_NAME=
VK_CONFIRMATION_CODE=
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Почта для восстановления пароля, например Яндекс 360
SMTP_URL="smtps://no-reply%40mioflow.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465"
MAIL_FROM="MioFlow <no-reply@mioflow.ru>"
# Push через серверы Expo — трансграничная передача, включать после уведомления РКН
PUSH_ENABLED=false

# ── Мониторинг (deploy/scripts/monitor.sh, каждые 5 минут) ──
# Тревоги в Telegram: создайте отдельного бота у @BotFather, напишите ему /start,
# узнайте chat_id (https://api.telegram.org/bot<токен>/getUpdates). Без этих строк тревоги пишутся только в /var/log/mioflow-monitor.log
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ── Шифрование секретов салонов (ключи ЮKassa для предоплаты). Случайная строка 32+ символов:
#    openssl rand -base64 48. Не меняйте после запуска — иначе сохранённые ключи салонов не расшифруются ──
SECRETS_KEY=
