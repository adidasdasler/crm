# ── Production: скопируйте в .env в корне проекта на VPS, chmod 600 ──
# Сгенерировать секрет: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_USER=salon
POSTGRES_DB=salon
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Домены (замените salon.ru на свой)
CORS_ORIGIN=https://salon.ru,https://app.salon.ru
COOKIE_DOMAIN=.salon.ru
PUBLIC_WEB_URL=https://salon.ru
# Адрес API для веб-сборок (тот же домен через /v1 — без CORS)
API_URL=/v1

# ── Этап 2 ──
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
SMS_RU_API_KEY=
SENTRY_DSN=
