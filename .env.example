# ── Production: скопируйте в .env в корне проекта на VPS и выполните chmod 600 .env ──
# Секрет сгенерировать:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_USER=salon
POSTGRES_DB=salon
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Домены (замените salon.ru на свой)
PUBLIC_WEB_URL=https://salon.ru
APP_URL=https://app.salon.ru
# API отдаётся с тех же доменов по пути /v1, поэтому CORS и общий домен cookie не нужны.
CORS_ORIGIN=
COOKIE_DOMAIN=

# ── Telegram-бот (создать у @BotFather) ──
TELEGRAM_BOT_TOKEN=
# имя бота без @, например salon_reminders_bot
TELEGRAM_BOT_USERNAME=
# любой случайный секрет (той же командой openssl) — защищает вебхук
TELEGRAM_WEBHOOK_SECRET=

# ── SMS (sms.ru) — запасной канал для клиентов без Telegram ──
SMS_RU_API_KEY=
# имя отправителя (нужно согласовать в sms.ru), можно оставить пустым
SMS_SENDER=

# ── Оплата подписки (ЮKassa, магазин для самозанятого) ──
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Почта (восстановление пароля), например Яндекс 360 / Mail.ru для бизнеса ──
SMTP_URL=smtps://no-reply%40salon.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
MAIL_FROM=Пора <no-reply@pora.app>

# ── Push-уведомления (через серверы Expo — трансграничная передача, включать после уведомления РКН) ──
PUSH_ENABLED=false

# Бэкапы (необязательно): шифровать GPG-ключом получателя
BACKUP_GPG_RECIPIENT=
